@startuml
title UML sequence behaviour - Submit credential
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Financing professional" as actor
box "Frontend - Web application" #E0F2FE
  participant "ProviderEditorPage" as editor
end box
box "Backend - Route handlers" #D1FADF
  participant "ProvidersRoute" as route
end box
box "Backend - Application and Domain" #ECFDF3
  participant "CredentialService" as svc
end box
box "Backend - Infrastructure" #FFF4E5
  database "Database" as db
end box
actor -> editor : Submit financing profile with licence or credential
editor -> route : POST /api/providers
route -> route : Check credential present for financing professional (L2-033)
alt credential omitted
  route --> editor : 400 field error on credential
  editor --> actor : Show inline error, no profile created
else credential present
  route -> svc : submit(providerId, value)
  svc -> db : Insert credential with status Submitted
  db --> svc : Committed
  svc --> route : Credential
  route --> editor : 201 provider, not verified
  editor --> actor : Show Business submitted, Verified appears after the check
end
@enduml
