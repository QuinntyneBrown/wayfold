@startuml
title UML sequence behaviour - Verify credential
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Wayfold reviewer" as actor
box "Frontend - Web application" #E0F2FE
  participant "Reviewer interface <TO SUPPLY>" as ui
end box
box "Backend - Route handlers" #D1FADF
  participant "Verification entry point <TO SUPPLY>" as entry
end box
box "Backend - Application and Domain" #ECFDF3
  participant "CredentialVerification" as verify
end box
box "Backend - Infrastructure" #FFF4E5
  database "Database" as db
end box
actor -> ui : Choose a submitted credential after checking it
ui -> entry : Request verification
entry -> entry : Authorize Wayfold reviewer <TO SUPPLY>
entry -> verify : markVerified(credentialId, reviewerId)
verify -> db : Set status Verified, verifiedAt, verifiedBy (L2-033)
db --> verify : Committed
verify --> entry : Done
entry --> ui : Confirmation
ui --> actor : Show credential verified
@enduml
