@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Deal questions
Person(user, "Visitor, member or financing professional", "Uses deal questions")
System_Boundary(wayfold, "Wayfold") {
  Container(web, "Web application", "Next.js App Router, React", "Vehicle detail page and Ask about this deal dialog")
  Container(api, "Route handlers", "Next.js", "/api/vehicles/:id/questions and /api/questions/:id/answers")
  ContainerDb(db, "Database", "<TO SUPPLY>", "Questions, answers, providers and notifications")
}
System_Ext(email, "Email provider", "<TO SUPPLY>")
Rel(user, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
Rel(api, email, "Notifies the asker via", "<TO SUPPLY>")
@enduml
