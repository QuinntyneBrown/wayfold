@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Recommend
Person(member, "Signed-in member", "Recommends")
System_Boundary(wayfold, "Wayfold") {
  Container(web, "Web application", "Next.js App Router, React", "Provider page, products page, recommend dialog")
  Container(api, "Route handlers", "Next.js", "PUT recommendation endpoints and recommendation queries")
  ContainerDb(db, "Database", "<TO SUPPLY>", "Recommendations and products")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "<TO SUPPLY>")
@enduml
