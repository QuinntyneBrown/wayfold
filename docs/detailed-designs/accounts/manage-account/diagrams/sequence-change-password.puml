@startuml
title UML sequence behaviour - Change password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Member" as actor
box "Frontend - Web application" #E0F2FE
  participant "SettingsPage" as page
end box
box "Backend - Route handlers" #D1FADF
  participant "AccountRoute" as route
end box
box "Backend - Application and Domain" #ECFDF3
  participant "AccountService" as svc
  participant "PasswordHasher" as hasher
end box
box "Backend - Infrastructure" #FFF4E5
  database "Database" as db
end box
actor -> page : Enter current and new password and save
page -> route : PUT /api/account
route -> route : Authenticate session and validate fields
route -> svc : changePassword(userId, sessionId, request)
svc -> db : Load password hash
db --> svc : Hash
svc -> hasher : verify(currentPassword, hash)
hasher --> svc : Match or mismatch
alt current password incorrect
  svc --> route : Rejected
  route --> page : 400 field error on current password (L2-003)
  page --> actor : Show error, password unchanged
else current password correct
  svc -> hasher : hash(newPassword)
  hasher --> svc : Salted adaptive hash
  svc -> db : Store hash and invalidate all other sessions (L2-003)
  db --> svc : Committed
  svc --> route : Changed
  route --> page : 200
  page --> actor : Show Saved, other devices signed out
end
@enduml
